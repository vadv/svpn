#!/bin/sh
set -eu

uplink=$1
shift
primary_state=/run/svpn/primary.route
primary_lock=/run/svpn/primary.lock

primary_cleanup() {
    [ -f "$primary_state" ] || return 0
    owner=
    . "$primary_state"
    if [ -n "$owner" ] && [ "$owner" != "$SVPN_SESSION_ID" ] && [ -d "/proc/$owner" ]; then
        return 0
    fi
    ip -4 rule del pref 10000 from "$tun_addr" 2>/dev/null || true
    ip -4 rule del pref 10001 from "$tun_addr" 2>/dev/null || true
    ip -4 route del default table 10002 2>/dev/null || true
    ip -4 route del 0.0.0.0/1 dev "$tun_name" 2>/dev/null || true
    ip -4 route del 128.0.0.0/1 dev "$tun_name" 2>/dev/null || true
    for server in $servers; do
        ip -4 route del "$server/32" dev "$uplink" 2>/dev/null || true
    done
    rm -f "$primary_state"
}

case ${SVPN_HOOK_ROLE:-primary} in
primary)
    mkdir -p /run/svpn
    exec 9>"$primary_lock"
    flock -x 9
    primary_cleanup
    ;;
local-exit)
    peer=$SVPN_PEER_ADDR
    peer_id=$(printf '%s' "$peer" | tr '.-' '_')
    third=$(printf '%s' "$peer" | awk -F. '{print $3}')
    local_table=$((10003 + 254 - third))
    route_state="/run/svpn/local-exit.${peer_id}.route"
    [ -f "$route_state" ] || exit 0
    owner=
    . "$route_state"
    if [ -n "$owner" ] && [ "$owner" != "$SVPN_SESSION_ID" ] && [ -d "/proc/$owner" ]; then
        exit 0
    fi
    while ip -4 rule del pref "$local_table" from "$peer" lookup "$local_table" 2>/dev/null; do :; done
    ip -4 route flush table "$local_table" 2>/dev/null || true
    nft delete table inet "svpn_local_exit_${peer_id}" 2>/dev/null || true
    rm -f "$route_state"
    ;;
*)
    echo "client-down: unexpected role ${SVPN_HOOK_ROLE:-}" >&2
    exit 1
    ;;
esac
