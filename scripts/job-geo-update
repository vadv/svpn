# Автообновление ASN-базы (DB-IP ASN Lite, ежемесячно).
# Скопируйте блок в vpn.hcl целиком. svpn сам решает, когда качать (run_if),
# стартует не дожидаясь базы и подхватывает её вживую (reload).
# Проверить руками: svpn job run geo-update --config vpn.hcl
job "geo-update" {
  every   = "1h"
  timeout = "10m"
  run_if  = <<EOF
db=$SVPN_GEO_DB
[ -n "$db" ] || exit 1
[ -f "$db" ] || exit 0
# BSD stat and GNU stat shadow each other depending on PATH, and GNU `stat -f`
# even exits 0 with filesystem garbage — so validate the answer, not the code.
mtime=$(stat -f %m "$db" 2>/dev/null)
case "$mtime" in ''|*[!0-9]*) mtime=$(stat -c %Y "$db") ;; esac
file_month=$(date -u -d "@$mtime" +%Y-%m 2>/dev/null || date -u -r "$mtime" +%Y-%m)
[ -n "$file_month" ] || exit 1
[ "$file_month" = "$(date -u +%Y-%m)" ] && exit 1
exit 0
EOF
  run     = <<EOF
set -eu
db=$SVPN_GEO_DB
dir=$(dirname "$db")
mkdir -p "$dir"
tmp=$(mktemp "$dir/geo.XXXXXX")
# No partial files left behind on any failure path.
trap 'rm -f "$tmp" "$tmp.gz"' EXIT
url="https://download.db-ip.com/free/dbip-asn-lite-$(date -u +%Y-%m).csv.gz"
case "$SVPN_OS" in
  openwrt) wget -q -Q 104857600 -O "$tmp.gz" "$url" ;;
  *) curl -fsSL --max-filesize 104857600 "$url" -o "$tmp.gz" ;;
esac
[ "$(wc -c <"$tmp.gz")" -le 104857600 ] || { echo "geo-update: download exceeds 100 MiB" >&2; exit 1; }
# Cap the expanded file (~500 MiB in 512-byte blocks) before decompressing.
ulimit -f 976563 2>/dev/null || true
gzip -dc "$tmp.gz" >"$tmp"
rm -f "$tmp.gz"
# Validate rows, not lines: a broken mirror must not replace the database
# with a same-sized pile of garbage.
rows=$(grep -cE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+,[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+,[0-9]+' "$tmp")
[ "$rows" -ge 100000 ] || { echo "geo-update: suspicious download ($rows valid rows)" >&2; exit 1; }
mv "$tmp" "$db"
echo "geo-update: $rows rows installed"
EOF
  reload  = ["geo"]
}
