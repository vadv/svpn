#!/bin/sh
# Automatic client route cleanup. Called only when no manual down hook is set.
set -eu
# Hooks may run with a deliberately empty PATH; use the trusted system tools.
PATH=${SVPN_ROUTE_PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}
export PATH
umask 077

state_dir=${SVPN_ROUTE_STATE_DIR:-/var/run/svpn}
state="$state_dir/full-tunnel-$SVPN_SESSION_ID"

[ -f "$state" ] || exit 0
os=$(sed -n 's/^os //p' "$state")
tun=$(sed -n 's/^tun //p' "$state")
servers=$(sed -n 's/^servers //p' "$state")

case "$os" in
    linux)
        for server in $servers; do
            ip route del "$server/32" 2>/dev/null || true
        done
        ip route del 0.0.0.0/1 dev "$tun" 2>/dev/null || true
        ip route del 128.0.0.0/1 dev "$tun" 2>/dev/null || true
        ;;
    macos)
        for server in $servers; do
            route -n delete -inet -host "$server" 2>/dev/null || true
        done
        route -n delete -inet 0.0.0.0/1 -interface "$tun" 2>/dev/null || true
        route -n delete -inet 128.0.0.0/1 -interface "$tun" 2>/dev/null || true
        ;;
    *)
        echo "svpn: unsupported OS for route cleanup: $os" >&2
        exit 1
        ;;
esac
rm -f "$state"
